# Browser application
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://api:8000

# Pilot administrator placeholders. Replace before any external deployment.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Password

# Backend
ENVIRONMENT=development
COMPANY_NAME=Pilot Company
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://market_intel:market_intel@postgres:5432/market_intel
S3_BUCKET=market-intelligence-media
AWS_REGION=ap-south-1
# Optional after moving beyond the 2 GiB pilot host. Documents are rejected
# and Meta-delivered photos/voice notes remain unscanned when this is blank.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MONTHLY_BUDGET_USD=50
